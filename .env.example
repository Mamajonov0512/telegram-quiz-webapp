# =====================================================================
# TELEGRAM TEST PLATFORM - ENVIRONMENT VARIABLES SHABLONI
# =====================================================================
# Ushbu fayl faqat shablon hisoblanadi. Haqiqiy token va parollarni
# .env fayliga yoki Vercel Environment Variables bo'limiga kiriting.
# =====================================================================

# 1. Telegram Bot Token (@BotFather dan olingan bot tokeni)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Administratorlarning Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS=12345678,87654321

# 3. Supabase PostgreSQL Baza ulanish satri (Supabase -> Settings -> Database -> Connection string -> URI)
# Eslatma: Parol qismiga o'z bazangiz parolini yozing.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 4. Supabase API sozlamalari (Ixtiyoriy)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 5. Telegram Web App & Webhook URL (Vercel deploy domeni, masalan: https://my-quiz-app.vercel.app)
WEB_APP_URL=https://your-app-name.vercel.app
WEBHOOK_URL=https://your-app-name.vercel.app

# 6. Veb Admin panelga kirish maxfiy paroli
ADMIN_SECRET_KEY=admin12345

# 7. Test standart sozlamalari (ixtiyoriy)
TEST_QUESTIONS_COUNT=50
TEST_DURATION_MINUTES=50

# 8. Server sozlamalari (faqat lokal ishga tushirish uchun)
HOST=0.0.0.0
PORT=8000
