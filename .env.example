# Telegram Bot Token (@BotFather dan olingan bot tokeni)
BOT_TOKEN=

# Administratorlarning Telegram ID raqamlari (vergul bilan ajratilgan, masalan: 12345678,87654321)
ADMIN_IDS=12345678

# Web App URL (Telegram Web App uchun HTTPS havola, masalan: https://yourdomain.com yoki ngrok/localtunnel)
# Mahalliy tekshirish uchun bo'sh qoldirishingiz yoki http://localhost:8000 qilishingiz mumkin
WEB_APP_URL=http://localhost:8000

# Veb-server sozlamalari
HOST=0.0.0.0
PORT=8000

# Veb Admin panelga kirish maxfiy paroli
ADMIN_SECRET_KEY=admin12345

# Har bir testdagi savollar soni va beriladigan vaqt (daqiqa)
TEST_QUESTIONS_COUNT=50
TEST_DURATION_MINUTES=50
